## Template: append/override these lines in PentAGI's .env (pentagi/.env).
## Copy to env.lab, fill LLM_SERVER_KEY. The real env.lab stays outside git.

## LLM: DeepSeek flash only, via custom provider (all agents on deepseek-flash)
LLM_SERVER_URL=https://api.deepseek.com
LLM_SERVER_KEY=sk-YOUR-DEEPSEEK-KEY
LLM_SERVER_MODEL=deepseek-flash
LLM_SERVER_PRESERVE_REASONING=true
PENTAGI_LLM_SERVER_CONFIG_PATH=./pentagi-lab/deepseek-flash.provider.yml
LLM_SERVER_CONFIG_PATH=/opt/pentagi/conf/custom.provider.yml

## Workers: custom Kali image (offline tools) on the isolated lab network only.
## DOCKER_INSIDE=false keeps the Docker socket OUT of the workers
## (pkg/docker/client.go applyWorkerDockerAccess binds it only when inside=true).
DOCKER_NETWORK=labnet
DOCKER_INSIDE=false
DOCKER_PUBLIC_IP=127.0.0.1
DOCKER_IMAGE_SELECTION_MODE=fixed
DOCKER_DEFAULT_IMAGE_FOR_PENTEST=lab-kali
DOCKER_DEFAULT_IMAGE=lab-kali

## Pilot: no web search — measures the agent, not recall of public writeups.
## Flip DUCKDUCKGO_ENABLED=true for the search-on ablation later.
DUCKDUCKGO_ENABLED=false
